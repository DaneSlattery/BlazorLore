@page "/for-loop-test"

<h1>For Loop Test</h1>

<div class="container">
	@for (int i = 1; i <= 16; i++)
	{
		<div class="item">
			<p>Item @i</p>
		</div>
	}
</div>

<table>
	@for (int row = 0; row < 5; row++)
	{
		<tr>
			@for (int col = 0; col < 3; col++)
			{
				<td>Row @row, Col @col</td>
			}
		</tr>
	}
</table>

@code
{
	private int maxItems = 10;
}
