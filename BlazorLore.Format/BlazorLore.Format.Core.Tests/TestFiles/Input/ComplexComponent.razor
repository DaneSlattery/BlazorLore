@page "/counter"
@rendermode InteractiveAuto

@* comment to test comment handling *@

<PageTitle>Counter</PageTitle>
<h1>Counter</h1>
<p
	role="status">
	Current count:
	@currentCount
</p>
<button
	class="btn btn-primary"
	@onclick="IncrementCount">
	Click me
</button>

@code
{
	private int currentCount = 0;

	int IncrementCount()
	{
	currentCount++;
	return currentCount;
	}
}
